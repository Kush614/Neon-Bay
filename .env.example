# Server-side only. Never import these into apps/client.

# Game rules
EXPLOIT_ENABLED=true

# Lobby: humans who must be ready to start (spec default 2)
MIN_HUMANS=2

# Agents: stub (offline, deterministic) or anthropic
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low

# Sponsor adapters (leave blank to use the stub)
BRUIN_API_KEY=
BAND_API_KEY=
HARNESS_ROUTER_API_KEY=
RUNWARE_API_KEY=
FINCH_API_KEY=
TELEM_API_KEY=
GLASSER_API_KEY=
CASURO_API_KEY=
TEAMILY_API_KEY=
