# Server-side only. Never import these into apps/client.

# Game rules
EXPLOIT_ENABLED=true

# Lobby: humans who must be ready to start (spec default 2)
MIN_HUMANS=2

# Agents: stub (offline, deterministic) or anthropic
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low

# Sponsor adapters (leave blank to use the stub)
BRUIN_API_KEY=
# Bruin ledger warehouse. LEDGER_SINK=bruin pushes each session's ledger when it ends.
# BRUIN_WAREHOUSE: local file (default data/warehouse.duckdb) or md:neon_bay for MotherDuck.
LEDGER_SINK=stub
BRUIN_WAREHOUSE=
MOTHERDUCK_TOKEN=

# BAND crew channel (SPEC.md section 16). "band" mirrors crew whispers, deals and betrayals
# into a private Band room; anything else uses the stub. BAND_API_KEY is an agent-scoped key.
CREW_CHANNEL=stub
BAND_API_KEY=
BAND_REST_URL=https://app.band.ai

# Runware image generation, build time only (pnpm assets). "runware" generates real art;
# anything else writes flat placeholder PNGs. RUNWARE_MODEL overrides alibaba:qwen-image@3.0.
IMAGE_GENERATOR=stub
# Build-time 3D models (pnpm models): runware | stub
MODEL_GENERATOR=stub
RUNWARE_API_KEY=
RUNWARE_MODEL=

# Telem AI radio headlines. "telem" searches the past week's news; anything else plays invented local headlines.
NEWS_FEED=stub
TELEM_API_KEY=
