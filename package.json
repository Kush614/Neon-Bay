{
  "name": "neon-bay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --if-present run dev",
    "dev:client": "pnpm --filter @neon-bay/client dev",
    "dev:server": "pnpm --filter @neon-bay/server dev",
    "dev:agents": "pnpm --filter @neon-bay/agents dev",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "pnpm -r --if-present run typecheck && tsc --noEmit -p e2e",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
